-- Extensions
:set -XForeignFunctionInterface
:set -XUndecidableInstances

-- Load external packages and the generated Warmup module from the cabal
-- build's environment file at the repo root; interpret source files
-- (the build refreshes BuildVersion.hs in src/comp).
:set -package bsc

-- Haskell source
:set -i../comp:../comp/app:../comp/Libs:../comp/GHC/posix:../Parsec

-- Shared libraries and FFI bindings
:set -i../vendor/stp/HaskellIfc
:set -i../vendor/yices/v2.6/HaskellIfc
:set -i../vendor/htcl

:set -I/usr/include/tcl

:set -L../../inst/lib/SAT
:set -lstp
:set -lyices

-- Faster compilation times
:set -j
