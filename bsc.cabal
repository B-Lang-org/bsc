cabal-version: 3.16

-- Bluespec compiler package: one library (src/comp, vendored Parsec, and Tcl
-- and solver bindings) plus eight executables under src/comp/app (doc/cabal.md).
name: bsc
version: 2026.7
synopsis: Bluespec Compiler (BSC)
description: Toolchain for the Bluespec Hardware Definition Language
homepage: https://github.com/B-Lang-org/bsc
license: BSD-3-Clause
license-file: COPYING
author: Bluespec, Inc.
maintainer: bsc-dev@groups.io
category: Hardware
build-type: Hooks
extra-source-files:
  -- Version refreshed by Make and preserved in source distributions.
  src/comp/BuildVersion.hs
  -- Scripts invoked by SetupHooks.hs.
  platform.sh
  src/comp/update-build-version.sh
-- GHC versions tested in CI (.github/workflows/ci.yml).
tested-with:
  GHC == 9.4.7,
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.2,
  GHC == 9.14.1

custom-setup
  setup-depends:
    base        >=4.17.2.0 && <4.23,
    Cabal       ^>=3.16,
    Cabal-hooks ^>=3.16,
    containers  >=0.6.7 && <0.9,
    directory   >=1.3.7.1 && <1.4,
    filepath    >=1.4.2.2 && <1.6,
    process     >=1.6.17.0 && <1.7,

common common_all
  default-language: GHC2021
  ghc-options:
    -Wall -Wno-orphans -Wno-name-shadowing -Wno-unused-matches
    -Wtabs -Werror=missing-home-modules -fmax-pmcheck-models=800
  -- Bounds span GHC 9.4.7 through 9.14.1.
  build-depends:
    array        >=0.5.4.0 && <0.6,
    base         >=4.17.2.0 && <4.23,
    bytestring   >=0.11.5.2 && <0.13,
    containers   >=0.6.7 && <0.9,
    deepseq      >=1.4.8.0 && <1.6,
    directory    >=1.3.7.1 && <1.4,
    filepath     >=1.4.2.2 && <1.6,
    mtl          >=2.2.2 && <2.4,
    old-time     ^>=1.1.1.0,
    process      >=1.6.17.0 && <1.7,
    regex-compat ^>=0.95.2.2,
    split        ^>=0.2.5,
    strict-concurrency ^>=0.2.4.3,
    syb          ^>=0.7.2,
    text         >=2.0.2 && <2.2,
    time         >=1.12.2 && <1.16,
    unix         >=2.7.3 && <2.9,

library
  import: common_all
  -- Include the rule-bearing dependencies of base in Warmup. ghc-prim
  -- defines GHC.Classes before GHC 9.14, so Warmup must load it before an
  -- -O0 module can, or GHC caches that interface without its unfoldings.
  build-depends:
    ghc-bignum >=1.3 && <1.5,
    ghc-prim   >=0.9 && <0.14
  if impl(ghc >= 9.10)
    build-depends: ghc-internal <9.1500
  -- Generated by SetupHooks.hs into the component's autogen directory.
  autogen-modules: Warmup
  -- The Tcl loader behind Bluetcl's sessions; scripts use Bluetcl, not this.
  other-modules: HTclRuntime
  hs-source-dirs:
    src/comp
    src/comp/Libs
    src/comp/GHC/posix
    src/Parsec
    src/vendor/htcl
    src/vendor/stp/HaskellIfc
    src/vendor/yices/v2.6/HaskellIfc
  -- Link stp and yices by name without embedding a build-time library path:
  -- `make install-src` passes inst/lib/SAT via LIBRARY_PATH, and at run time
  -- the relative rpath resolves ../lib/SAT beside the executable (doc/cabal.md).
  extra-libraries: stp, yices
  if os(osx)
    extra-libraries: c++
    ld-options: -Wl,-rpath,@loader_path/../lib/SAT
  else
    extra-libraries: stdc++
    ld-options: -Wl,-rpath,$ORIGIN/../lib/SAT
  c-sources:
    src/vendor/htcl/haskell.c,
