common common_exes
  import: common_all
  build-depends: bsc
  hs-source-dirs: src/comp/app
  ghc-options: -rtsopts "-with-rtsopts=-H256m -K10m -i1"

executable bsc
  import: common_exes
  ghc-options: -main-is Main_bsc
  main-is: bsc.hs

executable bluetcl
  import: common_exes
  c-sources:
    src/comp/app/bluetcl_shim.c,
  ghc-options: -main-is Main_bluetcl
  main-is: BluetclMain.hs

executable bsc2bsv
  import: common_exes
  ghc-options: -main-is Main_bsc2bsv
  main-is: bsc2bsv.hs

executable bsv2bsc
  import: common_exes
  ghc-options: -main-is Main_bsv2bsc
  main-is: bsv2bsc.hs

executable dumpba
