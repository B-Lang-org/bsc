#!/bin/sh
# Launcher for the bluehs tools that works from any directory.
#
# Invoke directly:            util/bluehs/bluehs dumpbo foo.bo
# or via the bin/ symlinks:   util/bluehs/bin/dumpbo foo.bo
# (the symlink name selects the tool)
#
# A named tool is the program of that name under src/comp/app, run by
# runghc instead of being compiled.  runghc executes the file's `main`
# whatever the module is called, so the entry files the cabal executables
# use (module Main_dumpbo and friends) are also the scripts, with no
# second copy to keep in step.  Any path to a .hs file works too.
#
# Sets up two things a compiled binary would not need:
#   GHC_ENVIRONMENT - absolute path to the repo's GHC package environment,
#                     so runghc finds the compiled bsc library from any cwd
#   BLUESPECDIR     - defaulted to <repo>/inst/lib (showrules/vcdcheck use it
#                     for %-expansion and default .ba search paths); a
#                     compiled binary derives it from its own location, which
#                     runghc cannot do because the script is not installed

SELF=$(readlink -f "$0")
REPO=$(dirname "$(dirname "$(dirname "$SELF")")")
APP=$REPO/src/comp/app

NAME=$(basename "$0")
if [ "$NAME" = "bluehs" ]; then
    TOOL="$1"
    shift
else
    TOOL="$NAME"
fi

case "$TOOL" in
    *.hs) SCRIPT="$TOOL" ;;
    *)    SCRIPT="$APP/$TOOL.hs" ;;
esac
if [ ! -f "$SCRIPT" ]; then
    echo "bluehs: no such tool or script: $TOOL" >&2
    exit 1
fi

# The environment file is per GHC version, and the library in it was built by
# that GHC, so match the version of the ghc that runghc will use rather than
# taking whichever file is there.
VERSION=$(ghc --numeric-version 2>/dev/null)
if [ -z "$VERSION" ]; then
    echo "bluehs: no ghc on PATH" >&2
    exit 1
fi
ENVFILE=$(ls "$REPO"/.ghc.environment.*-"$VERSION" 2>/dev/null | head -1)
if [ ! -f "$ENVFILE" ]; then
    echo "bluehs: no .ghc.environment.*-$VERSION at $REPO --- run util/bluehs/setup.sh with ghc $VERSION" >&2
    exit 1
fi

GHC_ENVIRONMENT="$ENVFILE" export GHC_ENVIRONMENT
BLUESPECDIR="${BLUESPECDIR:-$REPO/inst/lib}" export BLUESPECDIR

exec runghc "$SCRIPT" "$@"
