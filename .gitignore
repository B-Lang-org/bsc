# Note: Only the most general ignore patterns are in this file.
#       There are area-specific .gitignore files for the source
#       directories etc.

# Ignore editor backup files
*~

# Ignore the inst directory
inst

# And the build directory
build
dist-newstyle/

.vagrant/
vagrant-out/

# bluehs: the GHC package environment cabal writes, and machine-local cabal
# settings
.ghc.environment.*
cabal.project.local
