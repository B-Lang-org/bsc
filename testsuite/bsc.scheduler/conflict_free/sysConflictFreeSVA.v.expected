`ifdef BSV_ASSIGNMENT_DELAY
`else
  `define BSV_ASSIGNMENT_DELAY
`endif

`ifdef BSV_POSITIVE_RESET
  `define BSV_RESET_VALUE 1'b1
  `define BSV_RESET_EDGE posedge
`else
  `define BSV_RESET_VALUE 1'b0
  `define BSV_RESET_EDGE negedge
`endif

module sysConflictFreeSVA(CLK,
			  RST_N);
  input  CLK;
  input  RST_N;

  // register count
  reg [3 : 0] count;
  wire [3 : 0] count$D_IN;
  wire count$EN;

  // ports of submodule fifo
  wire [7 : 0] fifo$D_IN;
  wire fifo$CLR, fifo$DEQ, fifo$EMPTY_N, fifo$ENQ, fifo$FULL_N;

  // rule scheduling signals
  wire WILL_FIRE_RL_even, WILL_FIRE_RL_odd;

  // submodule fifo
  FIFO2 #(.width(32'd8), .guarded(1'd1)) fifo(.RST(RST_N),
					      .CLK(CLK),
					      .D_IN(fifo$D_IN),
					      .ENQ(fifo$ENQ),
					      .DEQ(fifo$DEQ),
					      .CLR(fifo$CLR),
					      .D_OUT(),
					      .FULL_N(fifo$FULL_N),
					      .EMPTY_N(fifo$EMPTY_N));

  // rule RL_even
  assign WILL_FIRE_RL_even = fifo$FULL_N && !count[0] ;

  // rule RL_odd
  assign WILL_FIRE_RL_odd = fifo$FULL_N && count[0] ;

  // register count
  assign count$D_IN = count + 4'd1 ;
  assign count$EN = 1'd1 ;

  // submodule fifo
  assign fifo$D_IN = WILL_FIRE_RL_even ? 8'd0 : 8'd1 ;
  assign fifo$ENQ = WILL_FIRE_RL_even || WILL_FIRE_RL_odd ;
  assign fifo$DEQ = fifo$EMPTY_N ;
  assign fifo$CLR = 1'b0 ;

  // handling of inlined registers

  always@(posedge CLK)
  begin
    if (RST_N == `BSV_RESET_VALUE)
      begin
        count <= `BSV_ASSIGNMENT_DELAY 4'd0;
      end
    else
      begin
        if (count$EN) count <= `BSV_ASSIGNMENT_DELAY count$D_IN;
      end
  end

  // synopsys translate_off
  `ifdef BSV_NO_INITIAL_BLOCKS
  `else // not BSV_NO_INITIAL_BLOCKS
  initial
  begin
    count = 4'hA;
  end
  `endif // BSV_NO_INITIAL_BLOCKS
  // synopsys translate_on

  // handling of system tasks

  // synopsys translate_off
  always@(negedge CLK)
  begin
    #0;
    if (RST_N != `BSV_RESET_VALUE)
      if (WILL_FIRE_RL_odd && WILL_FIRE_RL_even)
	$display("Error: \"ConflictFreeSVA.bs\", line 17, column 20: (R0002)\n  Conflict-free rules RL_odd and RL_even called conflicting methods enq and\n  enq of module instance fifo.\n");
  end
  // synopsys translate_on

  `ifdef FORMAL
  // Error: "ConflictFreeSVA.bs", line 17, column 20: (R0002)
  //   Conflict-free rules RL_odd and RL_even called conflicting methods enq and
  //   enq of module instance fifo.
  always@(posedge CLK)
  if (RST_N != `BSV_RESET_VALUE)
    assert property (!(WILL_FIRE_RL_odd && WILL_FIRE_RL_even));
  `endif
endmodule  // sysConflictFreeSVA

