
# Test extractions to and from various size data
test_c_veri_bsv ExtractSizes

# Test those extractions but with out of bounds extractions (should return 0)
test_c_veri_bsv ExtractBounds "" 1548 1575

# Test shifting left and right with various size data
test_c_veri_bsv ShiftL
test_c_veri_bsv ShiftR
test_c_veri_bsv ShiftRA

# Large wide concatenations must not create increasingly nested C++ calls.
# Simulation checks every segment, with both true and false assignment guards.
test_c_only_bsv_modules WideConcat mkWideConcatSource
if {$ctest == 1} {
    # Bound nesting while allowing inline expressions within each word.
    # Reject 1024 indentation columns, accounting for tabs and spaces.
    find_regexp_fail sysWideConcat.cxx {^(\t| {8}){128}}
    find_regexp_fail mkWideConcatSource.cxx {^(\t| {8}){128}}
}
