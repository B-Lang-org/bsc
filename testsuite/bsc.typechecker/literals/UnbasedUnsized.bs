package UnbasedUnsized() where

zeros8 :: Bit 8
zeros8 = '0

ones8 :: Bit 8
ones8 = '1

zeros32 :: Bit 32
zeros32 = '0

ones32 :: Bit 32
ones32 = '1

-- Width inferred from function argument context
isAllZeros :: Bit 8 -> Bool
isAllZeros x = (x == '0)

isAllOnes :: Bit 8 -> Bool
isAllOnes x = (x == '1)

-- '0 in pattern position
describeZero :: Bit 8 -> String
describeZero '0 = "all zeros"
describeZero _  = "nonzero"

-- '0 and '1 end at punctuation and operators, not just whitespace
pair :: (Bit 8, Bit 8)
pair = ('0,'1)

struct S = { a :: Bit 8; b :: Bit 8 }

s :: S
s = S {a='0;b='1}

andOnes :: Bit 8 -> Bit 8
andOnes x = '1&x

isOnes :: Bit 8 -> Bool
isOnes x = '1==x

-- With a closing quote, these are still Char literals
zeroChar :: Char
zeroChar = '0'

oneChar :: Char
oneChar = '1'

-- unpack gets a value of some other Bits type
onesU :: UInt 8
onesU = unpack '1
