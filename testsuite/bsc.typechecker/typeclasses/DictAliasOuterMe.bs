package DictAliasOuterMe where

guarded :: (Eq a) => a -> a -> Bool
guarded x y =
    let result when x == y = True
    in  result

{-# verilog sysDictAliasOuterMe #-}
sysDictAliasOuterMe :: Module Empty
sysDictAliasOuterMe =
    module
        rules
            "test": when True ==>
                action
                    $display "%0d" (guarded True True)
                    $finish 0
