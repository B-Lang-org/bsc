package ZeroBitListN where

-- GitHub issue #1106 (ListN counterpart): pack of a ListN with
-- zero-width elements reported an out-of-range bit extraction, and
-- unpack constructed a list with the wrong number of elements

import ListN

{-# verilog sysZeroBitListN #-}
sysZeroBitListN :: Module Empty
sysZeroBitListN = module
  rules
    when True ==> do
      let v :: ListN 4 (Bit 0)
          v = unpack 0
      $display "%0d" (pack (v == replicate 0))
      $display "%0d" (pack v)
      $display "%0d" (pack (select v 2))
      $display "%0d" (pack (head v))
      let w :: ListN 4 (Bit 0)
          w = replicate 0
      $display "%0d" (pack w)
      $finish
